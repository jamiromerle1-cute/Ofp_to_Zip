<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070A13"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Virtual OS Partition Manager"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stock Boot Core + Custom system.img Loader"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <!-- Partition Status Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 Boot Partition: Integrated Stock Kernel (boot.img)"
            android:textColor="#22C55E"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 Vendor Partition: Generic Vendor Overlay (vendor.img)"
            android:textColor="#22C55E"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSystemSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌 System Partition: [EMPTY - Load system.img]" 
            android:textColor="#FACC15"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnSelectSystemImg"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="📂 Select Custom system.img (GSI)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:backgroundTint="#2563EB"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnBootVmEngine"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="▶️ Boot Virtual Machine"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="#16A34A"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvPartitionLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="[Hypervisor] Stock boot.img &amp; kernel loaded in virtual RAM.
Select system.img to attach /system partition."/>
    </ScrollView>

</LinearLayout>
