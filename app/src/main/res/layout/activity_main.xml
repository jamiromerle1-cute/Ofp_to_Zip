<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F19"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Virtual Android Engine"
        android:textColor="#38BDF8"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvVirtualStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Virtual Environment Active (Offline)"
        android:textColor="#22C55E"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnCreateSpace"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="➕ Launch Virtual App"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnKillVirtual"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="⛔ Stop Virtual OS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Virtual Instance Process Log:"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvVirtualLog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E293B"
        android:padding="12dp"
        android:textColor="#F8FAFC"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:text="[System] Initializing Virtual Subsystem...
[Kernel] Virtual Process Sandbox Isolated.
[Memory] 512MB Allocation Reserved.
[Ready] Select an app to launch inside Virtual Android Environment."/>

</LinearLayout>
