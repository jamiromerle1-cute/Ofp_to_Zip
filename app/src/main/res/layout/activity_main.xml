<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/vmSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC0F172A"
        android:padding="12dp"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Native Virtual Android OS Core"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDisplayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Waiting for system.img mount..."
            android:textColor="#FACC15"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLoadImg"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📂 Load system.img"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#2563EB"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnBootVirtualEngine"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="▶️ Boot Real GSI"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:backgroundTint="#16A34A"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_alignParentBottom="true"
        android:background="#D9000000"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvExecutionLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:text="[Engine Log Ready]" />
    </ScrollView>

</RelativeLayout>
