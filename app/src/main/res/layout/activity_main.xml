<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Real Android Subsystem Environment"
        android:textColor="#38BDF8"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Offline Multi-Task Android Container Engine"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnLaunchSettings"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="⚙️ Android Settings"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#2563EB"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnLaunchStorage"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="📁 System Files"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#0D9488"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnPickRealApp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📱 Run Real App Inside Subsystem Container"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="#4F46E5"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Execution Logs:"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E293B"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvExecutionLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#22C55E"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="[Subsystem] Real Native Android Task Runtime Active.
[Container] Offline Intent Interceptor Ready."/>
    </ScrollView>

</LinearLayout>
