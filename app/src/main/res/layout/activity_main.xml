<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Visible URL Bar when browsing -->
    <LinearLayout
        android:id="@+id/urlBarLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#1E293B"
        android:padding="8dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etUrlInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Enter URL or search"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:background="#334155"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:imeOptions="actionGo"/>

        <Button
            android:id="@+id/btnGo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Go"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"
            android:minWidth="60dp"/>

    </LinearLayout>

    <!-- Main Menu ScrollView -->
    <ScrollView
        android:id="@+id/menuScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast Web (Updated)"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnRoblox"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="Roblox"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#EF4444"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btnTiktok"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="TikTok"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#EC4899"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btnYoutube"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="YouTube"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#DC2626"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"/>

            <Button
                android:id="@+id/btnWebSearch"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="Website Engine"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                android:layout_marginBottom="16dp"
                android:elevation="4dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"/>

</LinearLayout>
